# Copy this file to .env and replace the placeholder with your real key.
# The project is OpenAI-compatible and is not locked to DeepSeek.
OPENAI_API_KEY=sk-...

# Optional: set an OpenAI-compatible endpoint such as https://api.deepseek.com.
# Leave blank to use OpenAI's default endpoint.
OPENAI_BASE_URL=

# Optional: defaults to gpt-4o-mini when blank.
LLM_MODEL=gpt-4o-mini
